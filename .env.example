# ── Application ────────────────────────────────────────────────────────────────
EI_APP_NAME=Engineering Intelligence Platform
EI_DEBUG=false
EI_API_PREFIX=/api/v1

# ── Auth ───────────────────────────────────────────────────────────────────────
EI_SECRET_KEY=change-me-in-production
EI_ALGORITHM=HS256
EI_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
EI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eng_intel
EI_DATABASE_ECHO=false

# ── Neo4j ──────────────────────────────────────────────────────────────────────
EI_NEO4J_URI=bolt://localhost:7687
EI_NEO4J_USER=neo4j
EI_NEO4J_PASSWORD=neo4jpassword

# ── ChromaDB ───────────────────────────────────────────────────────────────────
EI_CHROMA_HOST=localhost
EI_CHROMA_PORT=8000
EI_CHROMA_COLLECTION=eng_intel_rag

# ── Jira ───────────────────────────────────────────────────────────────────────
EI_JIRA_BASE_URL=https://jira.example.com
EI_JIRA_API_TOKEN=
EI_JIRA_USER_EMAIL=

# ── GitHub ─────────────────────────────────────────────────────────────────────
EI_GITHUB_TOKEN=
EI_GITHUB_ORG=
EI_GITHUB_REPO=

# ── OpenAI (for embeddings) ───────────────────────────────────────────────────
EI_OPENAI_API_KEY=
EI_EMBEDDING_MODEL=text-embedding-3-small
EI_EMBEDDING_DIMENSIONS=1536

# ── Temporal ───────────────────────────────────────────────────────────────────
EI_TEMPORAL_HOST=localhost:7233
EI_TEMPORAL_NAMESPACE=default
EI_TEMPORAL_TASK_QUEUE=eng-intel-queue
