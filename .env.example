# ── RAG Orchestrator Platform Configuration ──────────────────────────
# Copy this file to .env and customize values

# Application
RAG_APP_NAME="RAG Orchestrator Platform"
RAG_DEBUG=true
RAG_LOG_LEVEL=INFO

# API Server
RAG_HOST=0.0.0.0
RAG_PORT=8000

# PostgreSQL (Metadata Store)
RAG_DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragplatform

# JWT Authentication
RAG_JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
RAG_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Qdrant (Vector Database)
RAG_QDRANT_HOST=localhost
RAG_QDRANT_PORT=6333
RAG_QDRANT_GRPC_PORT=6334
RAG_QDRANT_PREFER_GRPC=true

# Weaviate (Vector Database)
RAG_WEAVIATE_HOST=localhost
RAG_WEAVIATE_PORT=8080
RAG_WEAVIATE_GRPC_PORT=50051

# Chroma (Vector Database)
RAG_CHROMA_HOST=localhost
RAG_CHROMA_PORT=8001

# pgvector (Vector Database - separate from metadata DB)
RAG_PGVECTOR_URL=postgresql://raguser:ragpass@localhost:5433/ragvectors

# Embedding Defaults
RAG_DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DEFAULT_EMBEDDING_DIMENSION=384
RAG_DEFAULT_CHUNK_SIZE=512
RAG_DEFAULT_CHUNK_OVERLAP=50

# Background Workers
RAG_MAX_INGESTION_WORKERS=4
RAG_INGESTION_BATCH_SIZE=100

# Storage
RAG_RAW_DOCUMENT_STORAGE_PATH=/data/rag-documents
