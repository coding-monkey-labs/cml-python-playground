# ==========================================
# AI Video Cleaner Platform - Environment
# ==========================================

# PostgreSQL
POSTGRES_USER=videocleaner
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=videocleaner
DATABASE_URL=postgresql+asyncpg://videocleaner:changeme_in_production@postgres:5432/videocleaner

# Storage
STORAGE_PATH=/data/videos

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook

# Ollama (all open-source models)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_REVIEWER_MODEL=llama3:8b
OLLAMA_AUTO_PULL=true

# faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# For GPU acceleration, use:
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# FFmpeg
FFMPEG_THREADS=4

# Audio Noise Removal
NOISE_REDUCTION_ENABLED=true
NOISE_REDUCTION_STRENGTH=0.21

# Scoring Thresholds
FILLER_SCORE_THRESHOLD=0.4
ENGAGEMENT_SCORE_THRESHOLD=0.3
SILENCE_THRESHOLD_SECONDS=1.5

# Batch Processing
MAX_CONCURRENT_JOBS=3

# Frontend
REACT_APP_API_URL=http://localhost:8000
