{
  "name": "Video Cleaner Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-uploaded",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/pipelines/{{ $json.job_id }}/ingest",
        "sendBody": false,
        "options": {
          "timeout": 600000
        },
        "method": "POST"
      },
      "id": "run-ingestion",
      "name": "Run Ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "url": "=http://backend:8000/pipelines/{{ $json.job_id }}/analyze",
        "sendBody": false,
        "options": {
          "timeout": 300000
        },
        "method": "POST"
      },
      "id": "run-analysis",
      "name": "Run Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [750, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.edit_count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "check-edits",
      "name": "Has Edits?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/pipelines/{{ $json.job_id }}/edit",
        "sendBody": false,
        "options": {
          "timeout": 600000
        },
        "method": "POST"
      },
      "id": "run-editing",
      "name": "Run Editing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 200],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "url": "=http://backend:8000/jobs/{{ $json.job_id }}/status",
        "method": "PATCH",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "completed"
            }
          ]
        },
        "options": {}
      },
      "id": "update-status-complete",
      "name": "Mark Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1500, 200]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/jobs/{{ $json.job_id }}/status",
        "method": "PATCH",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "error_message",
              "value": "No edits required - video is clean"
            }
          ]
        },
        "options": {}
      },
      "id": "mark-no-edits",
      "name": "Mark No Edits Needed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'pipeline_complete', job_id: $json.job_id }) }}"
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1750, 300]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/jobs/{{ $json.job_id }}/status",
        "method": "PATCH",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "error_message",
              "value": "={{ $json.error || 'Pipeline execution failed' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "handle-error",
      "name": "Handle Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1000, 550]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Run Ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Ingestion": {
      "main": [
        [
          {
            "node": "Run Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Analysis": {
      "main": [
        [
          {
            "node": "Has Edits?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Edits?": {
      "main": [
        [
          {
            "node": "Run Editing",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark No Edits Needed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Editing": {
      "main": [
        [
          {
            "node": "Mark Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Complete": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark No Edits Needed": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "video-processing"
    }
  ]
}
